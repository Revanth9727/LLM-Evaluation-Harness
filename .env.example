############
# Candidate A (GPT via OpenAI)
############
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
A_OPENAI_MODEL=gpt-4o-mini

############
# Candidate B (Local Llama on your laptop)
# Option 1: llama.cpp server started with an OpenAI-compatible API
#   e.g., --host 127.0.0.1 --port 8080 --api-key "" (or omit)
############
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_API_KEY=
LLAMA_MODEL=llama3.1:8b

# Option 2 (if you use Ollama, often it's http://127.0.0.1:11434 but NOT always /v1 compatible)
# If you wrap Ollama with an OpenAI-compatible proxy, point LLAMA_BASE_URL to that proxy.

############
# Candidate C (another GPT model, also via OpenAI)
############
C_OPENAI_MODEL=gpt-4.1-mini

############
# Judge settings
############
JUDGE_MODE=mock          # mock in PR/smoke; set to live when you want real judge
JUDGE_OPENAI_MODEL=gpt-4o-mini

############
# Global
############
EVAL_SEED=1337